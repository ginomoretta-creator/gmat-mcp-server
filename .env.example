# OpenAI API Key for generating embeddings and search
OPENAI_API_KEY=your_openai_key_here

# Cache directory (optional - defaults to ./data/)
# CACHE_DIR=./data

# Base URL for GMAT documentation scraping
BASE_URL=https://documentation.help/gmat/

# MCP Server Port (optional)
MCP_PORT=8000

# --- GMAT execution / knowledge tools (runGmat, getGmatIdioms, list/getGmatSample) ---
# REQUIRED for runGmat: the GMAT bin folder containing GmatConsole(.exe).
# Output is read from <GMAT_BIN>\..\output, samples from <GMAT_BIN>\..\samples.
# GMAT_BIN=C:\Path\To\GMAT_R2025a\bin
# Override the samples dir (default: <GMAT_BIN>\..\samples)
# GMAT_SAMPLES=C:\Path\To\GMAT_R2025a\samples
# Extra local corpus of validated community scripts, listed with a 'community/' prefix
# (default: ./data/community-scripts/validated - keep it local; mixed licenses)
# GMAT_EXTRA_SAMPLES=./data/community-scripts/validated
# Idioms knowledge file (default: ./data/gmat_idioms.md)
# GMAT_IDIOMS=./data/gmat_idioms.md