{
  "name": "gmat-mcp-server",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ginomoretta-creator/gmat-mcp-server.git"
  },
  "description": "MCP server that turns NASA's GMAT into an AI copilot tool: headless script execution with validated outcomes (the write -> run -> fix loop), semantic search over the GMAT docs, a curated idioms knowledge base, and the NASA sample-script corpus.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node -r dotenv/config dist/index.js dotenv_config_path=.env.local",
    "dev": "nodemon --watch src --exec node --loader ts-node/esm src/index.ts",
    "setup": "node dist/setup.js",
    "setup:test": "NODE_ENV=test node dist/setup.js",
    "reembed": "node dist/reembedLocal.js",
    "harvest": "node scripts/harvest-corpus.mjs --manifest data/community-scripts/manifest.example.json",
    "test": "node test-smoke.mjs && node test-stale.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gmat",
    "orbital-mechanics",
    "astrodynamics",
    "mission-design",
    "claude",
    "ai-agent",
    "semantic-search"
  ],
  "author": "Gino Luciano Moretta",
  "license": "ISC",
  "packageManager": "pnpm@10.10.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.11.0",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.2",
    "ml-distance": "^4.0.1",
    "openai": "^5.19.1",
    "turndown": "^7.2.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/turndown": "^5.0.5",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
